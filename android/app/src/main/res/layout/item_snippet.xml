<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:minHeight="72dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp"
    app:rippleColor="#332F6BFF"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/itemContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Trigger pill + meta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/itemTrigger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/trig_chip_grad"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="200dp"
                    tools:text=";addr" />

                <TextView
                    android:id="@+id/itemUses"
                    style="@style/TrexMetaPill"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    tools:text="used 12×"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/itemDisabled"
                    style="@style/TrexMetaPill"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill_off"
                    android:text="Off"
                    android:textColor="@color/danger"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/itemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                tools:text="Office address"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/itemPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="221 Market Street, Suite 400, San Francisco, CA 94105" />

            <TextView
                android:id="@+id/itemAttachment"
                style="@style/TrexMetaPill"
                android:layout_marginTop="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:drawableStart="@drawable/ic_attach_small"
                android:drawablePadding="4dp"
                android:drawableTint="@color/accent"
                android:ellipsize="middle"
                android:maxWidth="240dp"
                android:textColor="@color/text"
                android:visibility="gone"
                tools:text="Price list.pdf"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/itemMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/muted"
            android:contentDescription="More options" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
