<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:ignore="HardcodedText">

    <!-- Ambient top glow -->
    <View
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_gravity="top"
        android:background="@drawable/top_glow"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="104dp">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true">

            <!-- ============ Brand header ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="4dp"
                        android:src="@drawable/ic_logo"
                        android:importantForAccessibility="no" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="Trexpanda"
                        android:textColor="@color/text"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type Less. Do More."
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/liveChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    android:background="@drawable/live_pill"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="6dp"
                    android:contentDescription="Live sync is on">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/dot_live" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live"
                        android:textColor="#BCD4FF"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Stats card ============ -->
            <LinearLayout
                android:id="@+id/statsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/statTimeTile"
                    style="@style/TrexStatTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/statTimeSaved"
                        style="@style/TrexStatValue"
                        android:textColor="@color/accent"
                        tools:text="12 min" />

                    <TextView
                        style="@style/TrexStatLabel"
                        android:text="Time saved" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/statExpansionsTile"
                    style="@style/TrexStatTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/statExpansions"
                        style="@style/TrexStatValue"
                        tools:text="148" />

                    <TextView
                        style="@style/TrexStatLabel"
                        android:text="Expansions" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/statSnippetsTile"
                    style="@style/TrexStatTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/statSnippets"
                        style="@style/TrexStatValue"
                        tools:text="8" />

                    <TextView
                        style="@style/TrexStatLabel"
                        android:text="Snippets" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Account card ============ -->
            <LinearLayout
                android:id="@+id/accountCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/hero_bg"
                android:padding="16dp">

                <!-- Signed out -->
                <LinearLayout
                    android:id="@+id/signedOutGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLOUD SYNC"
                        android:textColor="@color/accent"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.14" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityHeading="true"
                        android:text="Sync snippets across devices"
                        android:textColor="@color/text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sign in once. Your snippets stay in sync on your phone and computer, updated live."
                        android:textColor="@color/muted"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Not signed in"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/signInButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:text="Sign in with Google"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/btn_primary"
                        android:drawableStart="@drawable/ic_google_g"
                        android:drawablePadding="10dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:stateListAnimator="@null"
                        android:elevation="2dp" />
                </LinearLayout>

                <!-- Signed in -->
                <LinearLayout
                    android:id="@+id/signedInGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/accountAvatar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/avatar_bg"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:importantForAccessibility="no"
                            tools:text="A" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/accountEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                android:textColor="@color/text"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:text="alex@yourcompany.com" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/syncProgress"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:indeterminate="true"
                                    android:visibility="gone"
                                    app:indicatorColor="@color/accent"
                                    app:indicatorSize="12dp"
                                    app:trackThickness="2dp" />

                                <TextView
                                    android:id="@+id/syncStatusText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:accessibilityLiveRegion="polite"
                                    android:textColor="@color/muted"
                                    android:textSize="13sp"
                                    tools:text="Synced 2 minutes ago" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/syncButton"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:textAllCaps="false"
                            android:text="Sync now"
                            app:icon="@drawable/ic_sync"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/signOutButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:minHeight="48dp"
                            android:textAllCaps="false"
                            android:text="Sign out"
                            app:icon="@drawable/ic_logout"
                            app:iconGravity="textStart" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteAccountButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:minHeight="48dp"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textColor="@color/danger"
                        android:text="Delete account…" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cloudSettingsButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:minHeight="48dp"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/accent"
                    android:text="Connect to Trexpanda cloud" />
            </LinearLayout>

            <!-- ============ Setup card ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/setupCard"
                style="@style/TrexCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Compact row once everything is set up -->
                    <LinearLayout
                        android:id="@+id/setupDoneRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/success"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Setup complete ✓"
                                android:textColor="@color/text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/setupDoneSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/muted"
                                android:textSize="13sp"
                                tools:text="Trexpanda Keyboard is ready" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/setupManageButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:textAllCaps="false"
                            android:text="Manage" />
                    </LinearLayout>

                    <!-- Step-by-step setup -->
                    <LinearLayout
                        android:id="@+id/setupSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="9dp"
                                android:background="@drawable/key_icon_bg"
                                android:src="@drawable/ic_keyboard"
                                app:tint="@color/accent"
                                android:importantForAccessibility="no" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:accessibilityHeading="true"
                                    android:text="Set up typing"
                                    android:textColor="@color/text"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/setupProgressText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/muted"
                                    android:textSize="13sp"
                                    tools:text="1 of 2 steps done" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/setupCollapseButton"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:visibility="gone"
                                android:contentDescription="Hide setup steps"
                                android:rotation="180"
                                app:icon="@drawable/ic_expand_more"
                                app:iconTint="@color/muted" />
                        </LinearLayout>

                        <!-- Step 1: enable the keyboard -->
                        <LinearLayout
                            style="@style/TrexStepRow"
                            android:layout_marginTop="12dp">

                            <ImageView
                                android:id="@+id/stepEnableIcon"
                                style="@style/TrexStepIcon"
                                android:src="@drawable/ic_circle_outline" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TrexStepTitle"
                                    android:text="1. Turn on Trexpanda Keyboard" />

                                <TextView
                                    android:id="@+id/stepEnableStatus"
                                    style="@style/TrexStepSubtitle"
                                    android:text="In Settings, switch on Trexpanda Keyboard." />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/enableKeyboardButton"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:textAllCaps="false"
                                android:text="Enable" />
                        </LinearLayout>

                        <!-- Step 2: switch to it -->
                        <LinearLayout
                            style="@style/TrexStepRow"
                            android:layout_marginTop="8dp">

                            <ImageView
                                android:id="@+id/stepSwitchIcon"
                                style="@style/TrexStepIcon"
                                android:src="@drawable/ic_circle_outline" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TrexStepTitle"
                                    android:text="2. Switch to it" />

                                <TextView
                                    android:id="@+id/stepSwitchStatus"
                                    style="@style/TrexStepSubtitle"
                                    android:text="Pick Trexpanda as your keyboard." />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/switchKeyboardButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:minHeight="48dp"
                                android:textAllCaps="false"
                                android:text="Switch" />
                        </LinearLayout>

                        <!-- OR divider -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:importantForAccessibility="no">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="@color/outline" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:text="OR KEEP YOUR KEYBOARD"
                                android:textColor="@color/subtle"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="@color/outline" />
                        </LinearLayout>

                        <!-- Optional: any-keyboard mode -->
                        <LinearLayout
                            style="@style/TrexStepRow"
                            android:layout_marginTop="12dp">

                            <ImageView
                                android:id="@+id/stepAnyIcon"
                                style="@style/TrexStepIcon"
                                android:src="@drawable/ic_circle_outline" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TrexStepTitle"
                                    android:text="Use with Gboard or any keyboard" />

                                <TextView
                                    android:id="@+id/anyKeyboardStatus"
                                    style="@style/TrexStepSubtitle"
                                    android:text="Optional. Expands triggers while you type with your usual keyboard." />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/anyKeyboardButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="48dp"
                            android:textAllCaps="false"
                            android:text="Use with Gboard or any keyboard" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Snippets header ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="22dp"
                android:paddingStart="2dp">

                <TextView
                    android:id="@+id/snippetsHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="MY SNIPPETS"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.13" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sortButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textAllCaps="false"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:text="A–Z"
                    app:icon="@drawable/ic_sort"
                    app:iconSize="18dp"
                    app:iconTint="@color/muted" />
            </LinearLayout>

            <!-- Search -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:boxCornerRadiusTopStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusBottomEnd="24dp"
                app:boxBackgroundColor="@color/surface"
                app:boxStrokeColor="@color/brand"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/muted"
                app:endIconMode="clear_text"
                app:endIconTint="@color/muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:hint="Search triggers, names or text"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingTop="10dp" />

            <!-- Empty state: no snippets at all -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/key_icon_bg"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="@color/accent"
                    android:textSize="26sp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="No snippets yet"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginHorizontal="16dp"
                    android:text="Create a shortcut like ;addr for text you type all the time: addresses, replies, links."
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emptyAddButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:textAllCaps="false"
                    android:text="New snippet"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <!-- Empty state: search has no matches -->
            <LinearLayout
                android:id="@+id/noMatchesState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/subtle"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/noMatchesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="16dp"
                    android:gravity="center"
                    android:text="No snippets match your search"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearSearchButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:textAllCaps="false"
                        android:text="Clear search" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/noMatchesAddButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="48dp"
                        android:textAllCaps="false"
                        android:text="New snippet"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="New snippet"
        android:text="New snippet"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:icon="@drawable/ic_add"
        app:iconTint="#FFFFFF"
        app:backgroundTint="@color/brand"
        app:elevation="10dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
